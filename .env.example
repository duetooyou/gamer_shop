# --- приложение ---
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true

# --- postgres ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=gamer_shop
POSTGRES_ECHO=false

# --- redis (очередь taskiq) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0

# --- поставщики (заглушки) ---
SUPPLIER_PRIMARY_URL=http://127.0.0.1:9101
SUPPLIER_FALLBACK_URL=http://127.0.0.1:9102
SUPPLIER_REQUEST_TIMEOUT=2.0

# Лимит, объявленный поставщиком, и запас, с которым мы идём ниже него.
# Своё ведро мы опустошаем на сетевую задержку раньше, чем ведро поставщика,
# поэтому на равных числах любое дрожание задержки даёт 429.
SUPPLIER_RATE_LIMIT_PER_MINUTE=60
SUPPLIER_RATE_LIMIT_SAFETY=0.9
# Всплеск: должен быть строго меньше того, что стерпит поставщик.
SUPPLIER_RATE_LIMIT_BURST=5
SUPPLIER_PERMIT_WAIT_SECONDS=5.0
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_BACKOFF_BASE=0.2
SUPPLIER_BACKOFF_MAX=2.0
SUPPLIER_BACKOFF_JITTER=0.1

# --- выдача и фоновое дожатие ---
DELIVERY_STUCK_AFTER_SECONDS=30
DELIVERY_BATCH_SIZE=100
DELIVERY_SCAN_INTERVAL_SECONDS=30

# --- порты, публикуемые docker compose на хост (на случай занятых портов) ---
API_PORT=8000
SUPPLIER_A_PORT=9101
SUPPLIER_B_PORT=9102

# --- лимит заглушек в docker compose ---
# Ставится заведомо выше того, с чем идёт магазин: превышение обязано быть
# видно (over_limit в /_stats), а не съедено запасом заглушки.
SUPPLIER_STUB_RATE_LIMIT_PER_MINUTE=120
SUPPLIER_STUB_RATE_LIMIT_BURST=10

# --- доля сбоев заглушек в docker compose ---
SUPPLIER_A_FAIL_RATE=0.2
SUPPLIER_A_TIMEOUT_RATE=0.2
SUPPLIER_B_FAIL_RATE=0.1
SUPPLIER_B_TIMEOUT_RATE=0.0

# Пул на один процесс: (pool_size + max_overflow) * число процессов
# должно укладываться в max_connections сервера.
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10

# --- платёжная система (заглушка возвратов) ---
PAYMENT_URL=http://127.0.0.1:9201
PAYMENT_REQUEST_TIMEOUT=2.0
PAYMENT_PORT=9201

# --- аутбокс (очередь команд) ---
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8
# Столько релей ждёт, упершись в лимит поставщика, прежде чем зайти снова.
OUTBOX_POLL_INTERVAL_SECONDS=1.0
DELIVERY_MAX_ATTEMPTS_BEFORE_REFUND=3
